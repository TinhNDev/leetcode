function twoSum(nums: number[], target: number): number[] {
    const visited:{[key:number]: number} ={};
    for(let i = 0; i <nums.length; i++){
        const neededNum = visited[target -  nums[i]];
        if(neededNum>=0){
            return [i, neededNum];
        }
        visited[nums[i]] = i;
    }
};
